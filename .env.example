# GhostTrace Root Environment Configuration
# Copy this file to .env to customize settings

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional Gemma 3 4B: install with `ollama pull gemma3:4b`, then set OLLAMA_MODEL=gemma3:4b.
OLLAMA_TIMEOUT_SECONDS=75.0
MAX_INPUT_CHAR_LIMIT=150000
